# Сайт: vite build → nginx
FROM node:20-slim AS build
WORKDIR /app
# URL админки для кнопки «Редактировать» (AdminEditLink) — по умолчанию админ-поддомен
ARG VITE_ADMIN_URL=https://admin.xn--b1aghca0aeahc1am7c.xn--p1ai
ENV VITE_ADMIN_URL=$VITE_ADMIN_URL
COPY package.json package-lock.json ./
COPY packages/db/package.json packages/db/
COPY apps/web/package.json apps/web/
RUN npm ci --workspace @newinvest/web --include-workspace-root=false
COPY apps/web apps/web
# API на том же origin в проде (/api проксирует Caddy) — билд без env-зависимостей
RUN npm run build -w @newinvest/web

FROM nginx:alpine
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY infra/docker/nginx.spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
