# API: prod (запуск через tsx — компиляция не требуется)
# Node 22 LTS: Node 20 EOL с апреля 2026 и подвержен CVE-2026-111497 (Node2Shell,
# Brotli OOB write → RCE). Пентест-ТЗ 2026-11, раздел 6.1.
FROM node:22-slim
WORKDIR /app

# bcryptjs — чистый JS (без native-модулей), toolchain для сборки не нужен
# (аудит 2026-11-14: замена bcrypt — закрыт critical tar / high node-pre-gyp)

COPY package.json package-lock.json ./
COPY packages/db/package.json packages/db/
COPY apps/api/package.json apps/api/
RUN npm ci --workspace @newinvest/api --include-workspace-root=false

ENV NODE_ENV=production

COPY packages/db packages/db
COPY apps/api apps/api

# API под непривилегированным пользователем node (аудит 2026-11-15, ТЗ 3);
# uploads — единственное, куда процессу нужна запись; node_modules — под кэш tsx
RUN mkdir -p /app/uploads && chown -R node:node /app/uploads /app/node_modules
USER node

EXPOSE 1003
# расширение vector нужно миграции 0000 (в самой миграции CREATE EXTENSION только с 0012)
# миграции идемпотентны; затем сервер
CMD ["sh", "-c", "node -e \"const{Client}=require('pg');const c=new Client({connectionString:process.env.DATABASE_URL});c.connect().then(()=>c.query('CREATE EXTENSION IF NOT EXISTS vector')).then(()=>c.end()).catch(e=>{console.error(e);c.end();process.exit(1)})\" && npm run migrate -w @newinvest/db && npx tsx apps/api/src/index.ts"]
