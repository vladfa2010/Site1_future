# Caddy: ЛОКАЛЬНЫЙ режим — HTTP без TLS, тот же домен (через /etc/hosts → 127.0.0.1).
# Punycode: xn--b1aghca0aeahc1am7c.xn--p1ai = инвестиционно.рф
{
  auto_https off
}

(security) {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
    -Server
  }
}

# Основной сайт (API и uploads — тот же origin)
http://xn--b1aghca0aeahc1am7c.xn--p1ai {
  import security

  handle /sitemap.xml {
      reverse_proxy api:1003
  }
  handle /robots.txt {
      reverse_proxy api:1003
  }

  # ТЗ-10: бот-детект (SSR-рендер для поисковиков/соцсетей). Локально — для паритета с продом.
  @bots {
      not path /uploads/* /api/*
      header_regexp User-Agent (?i)(googlebot|google-inspectiontool|bingbot|yandex(bot|accessibility|images|metrika|video)|duckduckbot|slurp|baiduspider|applebot|telegrambot|vkshare|facebookexternalhit|twitterbot|linkedinbot|whatsapp|discordbot|pinterestbot|redditbot|bytespider|seznambot|Mail\.RU_Bot|exabot)
  }
  handle @bots {
      rewrite * /render?path={uri}
      reverse_proxy api:1003 {
          header_up X-Bot-Render 1
          header_up User-Agent {http.request.header.User-Agent}
      }
  }

  handle /api/* {
      reverse_proxy api:1003
  }
  handle /uploads/* {
      reverse_proxy api:1003
  }
  handle {
      reverse_proxy web:80
  }
}

# Админка — отдельный поддомен
http://admin.xn--b1aghca0aeahc1am7c.xn--p1ai {
  import security

  # ТЗ-10: админка не должна попасть в индекс — статичный noindex-robots
  handle /robots.txt {
      respond 200 {
          body "User-agent: *
Disallow: /
"
      }
  }

  handle /api/* {
      reverse_proxy api:1003
  }
  handle /uploads/* {
      reverse_proxy api:1003
  }
  handle {
      reverse_proxy admin:80
  }
}
