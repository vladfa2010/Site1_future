# Caddy внутри моноконтейнера: статика web/admin из /srv, динамика — на 127.0.0.1:4000.
# Punycode: xn--b1aghca0aeahc1am7c.xn--p1ai = инвестиционно.рф
{
  auto_https off
}

(security) {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
    -Server
  }
}

# Основной сайт (API и uploads — тот же origin)
http://xn--b1aghca0aeahc1am7c.xn--p1ai {
  import security

  handle /sitemap.xml {
      reverse_proxy 127.0.0.1:4000
  }
  handle /robots.txt {
      reverse_proxy 127.0.0.1:4000
  }

  # Бот-детект (SSR-рендер для поисковиков/соцсетей) — паритет с продом
  @bots {
      not path /uploads/* /api/*
      header_regexp User-Agent (?i)(googlebot|google-inspectiontool|bingbot|yandex(bot|accessibility|images|metrika|video)|duckduckbot|slurp|baiduspider|applebot|telegrambot|vkshare|facebookexternalhit|twitterbot|linkedinbot|whatsapp|discordbot|pinterestbot|redditbot|bytespider|seznambot|Mail\.RU_Bot|exabot)
  }
  handle @bots {
      rewrite * /render?path={uri}
      reverse_proxy 127.0.0.1:4000 {
          header_up X-Bot-Render 1
          header_up User-Agent {http.request.header.User-Agent}
      }
  }

  handle /api/* {
      reverse_proxy 127.0.0.1:4000
  }
  handle /uploads/* {
      reverse_proxy 127.0.0.1:4000
  }
  handle {
      root * /srv/web
      try_files {path} /index.html
      file_server
  }
}

# Админка — отдельный поддомен
http://admin.xn--b1aghca0aeahc1am7c.xn--p1ai {
  import security

  # Админка не должна попасть в индекс — статичный noindex-robots
  handle /robots.txt {
      respond 200 {
          body "User-agent: *
Disallow: /
"
      }
  }

  handle /api/* {
      reverse_proxy 127.0.0.1:4000
  }
  handle /uploads/* {
      reverse_proxy 127.0.0.1:4000
  }
  handle {
      root * /srv/admin
      try_files {path} /index.html
      file_server
  }
}
