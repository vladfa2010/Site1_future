# Caddy внутри моноконтейнера: статика web/admin из /srv, динамика — на 127.0.0.1:4000.
# HTTPS — внутренний CA Caddy (tls internal); корень CA добавлен в доверенные Windows.
# Punycode: xn--b1aghca0aeahc1am7c.xn--p1ai = инвестиционно.рф
{
  # только локальные имена — публичный ACME (Let's Encrypt) не используем
}

(security) {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy strict-origin-when-cross-origin
    # CSP (аудит 2026-11-14): JWT в localStorage — любой XSS = кража токена.
    # Скрипты — только same-origin (сборки Vite без инлайна); стили допускают
    # инлайн (style-атрибуты React); srcDoc-iframe превью — под frame-src 'self'.
    # HSTS намеренно НЕ добавляем: внутренний CA + доступ по IP:8080 (HTTP-редирект).
    # CSP передаётся аргументом импорта (import security "<CSP>") — переопределение
    # отдельным header НЕ работает: сниппетный header применяется после сайтового.
    Content-Security-Policy "{args.0}"
    -Server
  }
}

# Основной сайт (API и uploads — тот же origin)
xn--b1aghca0aeahc1am7c.xn--p1ai {
  tls internal
  import security "default-src 'self'; script-src 'self' https://mc.yandex.ru https://yastatic.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://mc.yandex.ru; font-src 'self' data:; connect-src 'self' https://mc.yandex.ru; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"


  handle /sitemap.xml {
      reverse_proxy 127.0.0.1:4000
  }
  handle /robots.txt {
      reverse_proxy 127.0.0.1:4000
  }

  # Бот-детект (SSR-рендер для поисковиков/соцсетей) — паритет с продом
  @bots {
      not path /uploads/* /api/*
      header_regexp User-Agent (?i)(googlebot|google-inspectiontool|bingbot|yandex(bot|accessibility|images|metrika|video)|duckduckbot|slurp|baiduspider|applebot|telegrambot|vkshare|facebookexternalhit|twitterbot|linkedinbot|whatsapp|discordbot|pinterestbot|redditbot|bytespider|seznambot|Mail\.RU_Bot|exabot)
  }
  handle @bots {
      rewrite * /render?path={uri}
      reverse_proxy 127.0.0.1:4000 {
          header_up X-Bot-Render 1
          header_up User-Agent {http.request.header.User-Agent}
      }
  }

  handle /api/* {
      reverse_proxy 127.0.0.1:4000
  }
  handle /uploads/* {
      reverse_proxy 127.0.0.1:4000
  }
  # Медиа миграции WP: file_path вида https://домен/wp-content/uploads/...
  # — скачаны с прода в /app/uploads, раздаём статикой по тому же пути
  handle /wp-content/* {
      root * /app/uploads
      file_server
  }
  handle {
      root * /srv/web
      try_files {path} /index.html
      file_server
  }
}

# Админка — отдельный поддомен
admin.xn--b1aghca0aeahc1am7c.xn--p1ai {
  tls internal
  import security "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"

  # Админка не должна попасть в индекс — статичный noindex-robots
  handle /robots.txt {
      respond 200 {
          body "User-agent: *
Disallow: /
"
      }
  }

  handle /api/* {
      reverse_proxy 127.0.0.1:4000
  }
  handle /uploads/* {
      reverse_proxy 127.0.0.1:4000
  }
  handle {
      root * /srv/admin
      try_files {path} /index.html
      file_server
  }
}
