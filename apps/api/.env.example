# API — локальное dev-окружение
DATABASE_URL=postgres://vladislavbaklykov@localhost:5432/newinvest
# Локально любое значение; в production — обязательно сильный секрет ≥ 32 символов,
# иначе API не стартует (apps/api/src/config.ts, fail fast)
JWT_SECRET=dev-secret-change-me
PORT=4000

# Для seed супер-админа
ADMIN_EMAIL=admin@local.dev
ADMIN_PASSWORD=admin123

# Генерация обложек через Moonshot/Kimi Images API.
# ВАЖНО: MOONSHOT_* (не KIMI_* — рантайм Kimi Work экспортирует свои KIMI_* в дочерние процессы).
# Пусто = mock-режим (SVG-заглушки)
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_IMAGE_MODEL=kimi-image-preview

# Куда складывать сгенерированные/загруженные файлы
UPLOAD_DIR=uploads

# CORS: доверенные origin'ы через запятую (домены сайта и админки)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Email-уведомления (Resend). Без ключа — email-дайджесты отключены
RESEND_API_KEY=
RESEND_FROM="Инвестиционно.рф <noreply@example.com>"
# Публичный URL сайта (ссылки в письмах)
PUBLIC_SITE_URL=http://localhost:5173
# AI-сводка недели (опционально; MOONSHOT_API_KEY выше может использоваться и для этого)
MOONSHOT_TEXT_MODEL=moonshot-v1-8k
# Второй LLM-провайдер текстов (выбор в админке). Ключ также задаётся в админке (хранится в БД);
# приоритет: значение из БД > env. Фallback для всех LLM-настроек.
DEEPSEEK_API_KEY=

# Telegram-бот уведомлений (BotFather). Без токена TG-контур выключен
TG_BOT_TOKEN=
TG_BOT_USERNAME=  # без @; если пусто — подтянется через getMe
